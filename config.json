{
    "server": {
        "port": 8080
    },
    "paths": {
        "frontendDir": "frontend",
        "dataDir": "data_capture",
        "convertOutputDir": "data_converted",
        "convertScript": "tools/convert_to_lerobot.py"
    },
    "camera": {
        "fisheyeK1": -1.0,
        "fisheyeK2": 0.4,
        "fisheyeScale": 1.7,
        "brightness": 8,
        "contrast": 1.05,
        "exposureAuto": 0,
        "exposureTime": 15000,
        "exposureUpper": 25000,
        "gainAuto": 0,
        "gain": 3,
        "gammaEnable": 1,
        "gamma": 1.0,
        "sharpness": 1,
        "denoise": 1.2,
        "balanceWhiteAuto": 1,
        "maxWidth": 1280,
        "maxHeight": 720,
        "fps": 30,
        "multiCameraMaxWidth": 1280,
        "multiCameraMaxHeight": 720,
        "multiCameraFps": 15
    },
    "devices": {
        "left": {
            "type": "auto",
            "preferredType": "orbbec",
            "serialHint": ""
        },
        "right": {
            "type": "auto",
            "preferredType": "hikvision",
            "serialHint": ""
        }
    },
    "grippers": {
        "left": {
            "type": "auto",
            "preferredType": "manual"
        },
        "right": {
            "type": "auto",
            "preferredType": "manual"
        }
    },
    "stream": {
        "encodeIntervalMs": 30,
        "streamIntervalMs": 33,
        "jpegQuality": 95,
        "streamMaxWidth": 640,
        "frameSkipMs": 33
    },
    "slam": {
        "enabled": true,
        "depthScale": 0.001
    }
}
