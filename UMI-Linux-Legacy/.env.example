# 复制本文件为 .env，然后填入自己的真实配置。
# 不要把 .env 提交到 Git，也不要发给别人。

OPENAI_API_KEY=

# 如果你用 OpenAI 官方接口，通常不需要改 BASE_URL。
OPENAI_BASE_URL=https://api.openai.com/v1

# Ubuntu 运行时 SDK 路径示例。
HIKVISION_SDK_DIR=./third_party_sdk/hikvision
ORBBEC_SDK_DIR=./third_party_sdk/orbbec
GCAN_SDK_DIR=./third_party_sdk/gcan

# SocketCAN 默认设备名。
CAN_INTERFACE=can0
